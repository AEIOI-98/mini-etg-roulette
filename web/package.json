{
  "name": "mini-etg-roulette-web",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "python3 build_wasm.py",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run wasm && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:wager": "node --test --test-name-pattern=\"one red wager\" test/bridge.test.mjs",
    "test": "node --test test/bridge.test.mjs test/player.test.mjs && node test/storage.mjs",
    "test:browser": "node --test test/browser.test.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.65.0",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
